        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"id_unidade\": 1,\r\n  \"canalPedido\": \"APP\",\r\n  \"itens\": [\r\n    {\r\n      \"id_produto_unidade\": 1,\r\n      \"quantidade\": 1\r\n    }\r\n  ]\r\n}",
