            "exec": [
              "\r\npm.test(\"Pedido criado com sucesso\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\nconst resposta = pm.response.json();\r\n\r\npm.test(\"Pedido possui identificador\", function () {\r\n    pm.expect(resposta.id_pedido).to.exist;\r\n});\r\n\r\npm.test(\"Pedido aguarda pagamento\", function () {\r\n    pm.expect(resposta.status_pedido).to.eql(\"AGUARDANDO_PAGAMENTO\");\r\n});\r\n\r\nif (resposta.id_pedido) {\r\n    pm.collectionVariables.set(\"id_pedido\", resposta.id_pedido);\r\n}\r\n"
            ]
          }
        }
      ],
