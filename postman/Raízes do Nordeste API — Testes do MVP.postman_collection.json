  "item": [
    {
      "name": "01 - Login do Cliente",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "\r\nconst resposta = pm.response.json();\r\n\r\npm.test(\"Login realizado com sucesso\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Token de acesso recebido\", function () {\r\n    pm.expect(resposta.access_token).to.be.a(\"string\").and.not.empty;\r\n});\r\n\r\nif (resposta.access_token) {\r\n    pm.collectionVariables.set(\"token_cliente\", resposta.access_token);\r\n}\r\n"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token_cliente}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "username",
              "value": "cliente@raizes.com"
            },
            {
              "key": "password",
              "value": "Senha@123"
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/auth/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      },
      "response": []
    },
